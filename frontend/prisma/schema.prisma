datasource db {
  provider = "sqlite"
  url      = env("NEXT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String   @id @default(cuid())
  name                 String?
  email                String   @unique
  emailVerified        DateTime?
  image                String?

  // Billing
  stripeCustomerId     String?  @unique
  subscriptionId       String?  @unique
  plan                 Plan     @default(FREE)
  priceId              String?
  subscriptionStatus   String?

  monthlyMinutesLimit  Int      @default(30)
  monthlyMinutesUsed   Int      @default(0)
  monthlyResetAt       DateTime @default(now())
  resetToken           String?   @unique
  resetTokenExpiry     DateTime?

  password             String?

  accounts             Account[]
  sessions             Session[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ownedTeams           Team[]        @relation("UserOwnedTeams")
  memberships          Membership[]  @relation("UserMemberships")
  rssFeeds             RssFeed[]
  templates            Template[]
  wordpressCreds       WordpressCred?
  blog_posts           BlogPost[]
  is_admin             Boolean @default(false)

  // Email preferences
  emailRssNewContent Boolean @default(true)
  emailManualJobs    Boolean @default(true)
  emailWeeklyDigest  Boolean @default(false)

  landingContent LandingContent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  // NOTE: no @db.Text on SQLite
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum Role {
  MANAGER
  EDITOR
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User         @relation("UserOwnedTeams", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships Membership[] @relation("TeamMemberships")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("EDITOR")
  team      Team     @relation("TeamMemberships", fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
}

model Invite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      Role     @default(EDITOR)
  token     String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RssFeed {
  id            String   @id @default(cuid())
  userId        String
  url           String
  title         String?
  lastCheckedAt DateTime?
  lastItemGuid  String?
  active        Boolean  @default(true)
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  kind      String
  system    String
  user      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [userId], references: [id])
}

model WordpressCred {
  id        String   @id @default(cuid())
  userId    String   @unique
  siteUrl   String
  username  String
  appPass   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  status      BlogStatus @default(DRAFT)
  published_at DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  author_id   String
  author      User     @relation(fields: [author_id], references: [id])
  views       Int      @default(0)
  
  // SEO fields
  meta_title       String?
  meta_description String?
  meta_keywords    String?
  
  @@map("blog_posts")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LandingContent {
  id          String   @id @default(cuid())
  section     String   // 'hero', 'stats', 'features', 'testimonials', 'pricing', 'faq'
  key         String   // unique identifier within section
  locale      String   @default("en") // 'en' or 'de'
  
  // Content fields
  title       String?
  subtitle    String?
  description String?
  content     Json?    // For complex structured data
  
  // Display settings
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  
  // Metadata
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String
  creator     User     @relation(fields: [created_by], references: [id])
  
  @@unique([section, key, locale])
  @@map("landing_content")
}

model LandingStats {
  id          String   @id @default(cuid())
  locale      String   @default("en")
  
  episodes    String   @default("1,000+")
  episodesLabel String @default("Episodes Processed")
  
  creators    String   @default("500+")
  creatorsLabel String @default("Happy Creators")
  
  timeSaved   String   @default("10,000+")
  timeSavedLabel String @default("Hours Saved")
  
  rating      String   @default("4.9/5")
  ratingLabel String   @default("User Rating")
  
  isActive    Boolean  @default(true)
  updated_at  DateTime @updatedAt
  
  @@unique([locale])
  @@map("landing_stats")
}

model LandingFeature {
  id          String   @id @default(cuid())
  locale      String   @default("en")
  
  icon        String   // Emoji or icon name
  title       String
  description String
  benefits    Json     // Array of benefit strings
  
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  @@map("landing_features")
}

model LandingTestimonial {
  id          String   @id @default(cuid())
  locale      String   @default("en")
  
  name        String
  role        String
  company     String
  quote       String
  avatar      String?  // URL to avatar image
  rating      Int      @default(5)
  
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  @@map("landing_testimonials")
}
