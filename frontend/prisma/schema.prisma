datasource db {
  provider = "sqlite"             // keep sqlite for local dev
  url      = env("DATABASE_URL")  // e.g., file:./dev.db
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String   @id @default(cuid())
  name                 String?
  email                String   @unique
  emailVerified        DateTime?
  image                String?

  // Billing
  stripeCustomerId     String?  @unique
  subscriptionId       String?  @unique      // <— NEW
  plan                 Plan     @default(FREE)
  priceId              String?
  subscriptionStatus   String?

  monthlyMinutesLimit  Int      @default(30)
  monthlyMinutesUsed   Int      @default(0)
  monthlyResetAt       DateTime @default(now())

  password             String?

  accounts             Account[]
  sessions             Session[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  // NOTE: no @db.Text on SQLite
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}
