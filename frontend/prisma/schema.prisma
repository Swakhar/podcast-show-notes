datasource db {
  provider = "sqlite"             // keep sqlite for local dev
  url      = env("NEXT_DATABASE_URL")  // e.g., file:./dev.db
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String   @id @default(cuid())
  name                 String?
  email                String   @unique
  emailVerified        DateTime?
  image                String?

  // Billing
  stripeCustomerId     String?  @unique
  subscriptionId       String?  @unique
  plan                 Plan     @default(FREE)
  priceId              String?
  subscriptionStatus   String?

  monthlyMinutesLimit  Int      @default(30)
  monthlyMinutesUsed   Int      @default(0)
  monthlyResetAt       DateTime @default(now())
  resetToken           String?   @unique
  resetTokenExpiry     DateTime?

  password             String?

  accounts             Account[]
  sessions             Session[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ownedTeams           Team[]        @relation("UserOwnedTeams")
  memberships          Membership[]
  rssFeeds             RssFeed[]
  templates            Template[]
  wordpressCreds       WordpressCred?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  // NOTE: no @db.Text on SQLite
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum Role {
  MANAGER
  EDITOR
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("UserOwnedTeams", fields: [ownerId], references: [id])
  members   Membership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      Role     @default(EDITOR)
  team      Team     @relation(fields: [teamId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

model Invite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      Role     @default(EDITOR)
  token     String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RssFeed {
  id            String   @id @default(cuid())
  userId        String
  url           String
  title         String?
  lastCheckedAt DateTime?
  lastItemGuid  String?
  active        Boolean  @default(true)
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  kind      String
  system    String
  user      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [userId], references: [id])
}

model WordpressCred {
  id        String   @id @default(cuid())
  userId    String   @unique
  siteUrl   String
  username  String
  appPass   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

